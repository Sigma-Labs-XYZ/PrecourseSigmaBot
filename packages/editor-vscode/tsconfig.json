{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "lib": ["ESNext"],
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "test"]
}
