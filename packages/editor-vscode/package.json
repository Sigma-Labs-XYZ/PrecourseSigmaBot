{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "sigmabot-editor-context",
  "displayName": "SigmaBot Coach",
  "description": "Sigma Labs' AI tutor, inside VS Code. Learn to code with hints, reviews and setup help, with SigmaBot seeing the file you have open.",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "publisher": "SigmaLabsXYZ",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "sigmabot",
    "sigma labs",
    "tutor",
    "coach",
    "learn to code",
    "education",
    "ai"
  ],
  "galleryBanner": {
    "color": "#E4530A",
    "theme": "dark"
  },
  "homepage": "https://github.com/Sigma-Labs-XYZ/PrecourseSigmaBot#readme",
  "bugs": {
    "url": "https://github.com/Sigma-Labs-XYZ/PrecourseSigmaBot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sigma-Labs-XYZ/PrecourseSigmaBot.git",
    "directory": "packages/editor-vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sigmabot.open",
        "title": "SigmaBot: Open",
        "icon": "$(sigmabot-logo)"
      },
      {
        "command": "sigmabot.install",
        "title": "SigmaBot: Install CLI"
      }
    ],
    "icons": {
      "sigmabot-logo": {
        "description": "SigmaBot logo",
        "default": {
          "fontPath": "media/sigmabot-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sigmabot",
          "title": "SigmaBot",
          "icon": "media/sigmabot.svg"
        }
      ]
    },
    "views": {
      "sigmabot": [
        {
          "id": "sigmabot.welcome",
          "name": "SigmaBot",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "sigmabot.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SigmaBot",
      "properties": {
        "sigmabot.installCommand": {
          "type": "string",
          "default": "curl -fsSL https://github.com/Sigma-Labs-XYZ/PrecourseSigmaBot/releases/latest/download/install | bash",
          "markdownDescription": "Shell command run in a terminal (after confirmation) to install the SigmaBot CLI."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --outfile dist/extension.js --target node --format cjs --external vscode",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/vscode": "1.90.0",
    "@types/ws": "8.18.1"
  }
}
